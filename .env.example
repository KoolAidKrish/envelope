# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# Password for /admin. Use something long.
ADMIN_PASSWORD=change-me-to-something-long

# Signs login cookies. Any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
