---
// The shared event address. Guests sign in through their private /i/<token>
// link, so this page takes no names and says nothing about the event.
import GuestLayout from '../../../layouts/GuestLayout.astro';
import Envelope from '../../../components/Envelope.astro';
import { getEventBySlug } from '../../../lib/queries';
import { currentGuest } from '../../../lib/session';

const event = await getEventBySlug(Astro.params.slug ?? '');
if (event && (await currentGuest(Astro.cookies, event))) return Astro.redirect(`/e/${event.slug}/home`);
---

<GuestLayout title="Invitation" theme={event?.theme}>
  <main class="gate">
    <div class="gate-inner">
      <Envelope monogram="✶" enter />
      <div class="gate-heading">
        <h1>Invitations here are personal</h1>
        <p>Open the link your host sent you. If you can't find it, ask them to send it again.</p>
      </div>
    </div>
  </main>
</GuestLayout>
