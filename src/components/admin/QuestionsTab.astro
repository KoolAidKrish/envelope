---
import type { EventRow, PostRow } from '../../lib/queries';
import { timeAgo } from '../../lib/time';

interface Props {
  event: EventRow;
  posts: PostRow[];
}
const { posts } = Astro.props;
---

<div class="panel" style="max-width:760px">
  <div class="panel-head">
    <h2>Questions from guests</h2>
    <p>Unanswered first</p>
  </div>
  {
    posts.length === 0 ? (
      <div class="empty-state">
        <strong>No questions yet</strong>
        Guests can ask you things from their invitation. They show up here.
      </div>
    ) : (
      <ul class="rows">
        {posts.map((p) => (
          <li class="row">
            <div class="row-main">
              <p class="row-title">
                {p.guest_name}{' '}
                <span class:list={['badge', { accent: p.is_public }]}>{p.is_public ? 'Everyone can see' : 'Private'}</span>
                {!p.reply && <span class="badge no">Needs a reply</span>}
              </p>
              <span class="row-sub">{timeAgo(p.created_at)}</span>
            </div>
            <p class="quote" style="margin:8px 0 12px">{p.body}</p>
            <form method="post" class="form">
              <input type="hidden" name="action" value="reply" />
              <input type="hidden" name="post" value={p.id} />
              <label class="field">
                <span class="visually-hidden">Your reply</span>
                <textarea name="reply" rows="2" maxlength="4000" placeholder="Write a reply">{p.reply}</textarea>
              </label>
              <div class="form-actions">
                <button class="btn btn-small" type="submit">
                  {p.reply ? 'Update reply' : 'Send reply'}
                </button>
              </div>
            </form>
            <div class="row-actions" style="margin-top:10px">
              <form method="post" class="inline">
                <input type="hidden" name="action" value="set_public" />
                <input type="hidden" name="post" value={p.id} />
                <input type="hidden" name="public" value={p.is_public ? 'no' : 'yes'} />
                <button class="btn-link" type="submit">
                  {p.is_public ? 'Make private' : 'Share with everyone'}
                </button>
              </form>
              <form method="post" class="inline" data-confirm="Delete this question and its reply?">
                <input type="hidden" name="action" value="delete_post" />
                <input type="hidden" name="post" value={p.id} />
                <button class="btn-link danger" type="submit">
                  Delete
                </button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</div>
